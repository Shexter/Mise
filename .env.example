# Copy this file to `.env` and fill in your key to skip retyping it on every fresh
# install during development. `.env` is gitignored.
#
#   cp .env.example .env
#
# This is a DEVELOPMENT CONVENIENCE ONLY. The value is inlined into the JS bundle
# at build time (see app.config.ts), so anyone with the build can read it. On first
# launch the app copies it into the device Keychain and reads it from there after.
#
# It is ignored unless the explicit development-only opt-in below is true.
# Leave both unset when you publish. Users add their own key in Settings.
#
# Accepts EITHER provider's key (the app auto-detects which):
#   - Google Gemini (free tier):  https://aistudio.google.com/apikey
#   - Anthropic Claude (paid):    https://console.anthropic.com/settings/keys
# The var keeps its historical name but is not Anthropic-specific.
MISE_DEV_API_KEY=
MISE_BUNDLE_DEV_API_KEY=false

# Release/CI builds set this to the exact committed source hash. EAS builds can
# use EAS_BUILD_GIT_COMMIT_HASH instead.
MISE_SOURCE_REVISION=development
